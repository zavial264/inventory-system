# Supabase project settings → API
# Copy this file to .env.local and fill in your own project's values.
#
# These are read on the server only, so they carry no NEXT_PUBLIC_ prefix and
# are never sent to the browser.
#Public URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Newer Supabase projects call this the "publishable key". Older projects show
# it as the "anon public" key; in that case set SUPABASE_ANON_KEY instead.
#Publishable Key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Project Settings → API → service_role (secret). Used when a
# Super Admin creates platform users from /users. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin used for Open Graph / Twitter image URLs.
# On Vercel this is inferred from the deployment; set it for a custom domain.
# APP_URL=https://your-domain.com
