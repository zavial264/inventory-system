# Supabase project settings → API
# Copy this file to .env.local and fill in your own project's values.
#
# These are read on the server only, so they carry no NEXT_PUBLIC_ prefix and
# are never sent to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co

# Newer Supabase projects call this the "publishable key". Older projects show
# it as the "anon public" key; in that case set SUPABASE_ANON_KEY instead.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
