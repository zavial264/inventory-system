# Supabase project settings → API
# Copy this file to .env.local and fill in your own project's values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Newer Supabase projects call this the "publishable key". Older projects show
# it as the "anon public" key and set NEXT_PUBLIC_SUPABASE_ANON_KEY instead;
# either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
